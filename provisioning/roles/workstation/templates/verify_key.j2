#!/bin/bash
# verify_key  --  Level 6 oracle.
# Submit the 256-bit key produced by your /dev/urandom-based generator.
#   ./verify_key <64-hex-char key>      or      echo <key> | ./verify_key
key="${1:-$(cat)}"
key="$(printf '%s' "$key" | tr -d '[:space:]')"

if ! printf '%s' "$key" | grep -Eq '^[0-9a-fA-F]{64}$'; then
    echo "[-] Rejected: a 256-bit key must be exactly 64 hexadecimal characters."
    echo "    (128 bits = 32 hex chars; you need twice that.)"
    exit 1
fi

# Confirm this machine's /dev/urandom really is high quality, using ent.
tmp="$(mktemp)"; head -c 1M /dev/urandom > "$tmp"
bits="$(ent "$tmp" 2>/dev/null | awk -F'=' '/Entropy/{print $2+0}')"
rm -f "$tmp"
ok="$(awk -v e="$bits" 'BEGIN{print (e>=7.9)?1:0}')"
if [ "$ok" != "1" ]; then
    echo "[-] /dev/urandom entropy check failed (ent measured $bits bits/byte)."
    exit 1
fi

echo "[+] Accepted: 256-bit key, and /dev/urandom measured $bits bits/byte."
echo "FLAG: {{ l6_flag }}"
